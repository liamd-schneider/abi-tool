{
  "name": "abi-tool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "create-admin": "node --env-file=.env.local scripts/create-admin.mjs",
    "db:push": "node --env-file=.env.local -e \"require('child_process').execSync('npx supabase db push --yes --remote='+JSON.stringify(process.env.DATABASE_URL),{stdio:'inherit'})\"",
    "typecheck": "tsc --noEmit",
    "make-platform-admin": "node --env-file=.env.local scripts/make-platform-admin.mjs",
    "dev:staging": "node --env-file=.env.staging.local node_modules/next/dist/bin/next dev",
    "build:staging": "node --env-file=.env.staging.local node_modules/next/dist/bin/next build",
    "start:staging": "node --env-file=.env.staging.local node_modules/next/dist/bin/next start",
    "db:push:staging": "node --env-file=.env.staging.local -e \"require('child_process').execSync('npx supabase db push --yes --remote='+JSON.stringify(process.env.DATABASE_URL),{stdio:'inherit'})\""
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "supabase": "^3.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
